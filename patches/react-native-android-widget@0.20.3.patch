diff --git a/android/src/main/java/com/reactnativeandroidwidget/WidgetClickIntent.java b/android/src/main/java/com/reactnativeandroidwidget/WidgetClickIntent.java
new file mode 100644
index 0000000000000000000000000000000000000000..0b9a3d5ae4cb31b7c0686e5b2ba39e04d7f342d7
--- /dev/null
+++ b/android/src/main/java/com/reactnativeandroidwidget/WidgetClickIntent.java
@@ -0,0 +1,39 @@
+package com.reactnativeandroidwidget;
+
+import android.app.PendingIntent;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+
+/** Stable identity for an individual RemoteViews click; extras are not intent identity. */
+public final class WidgetClickIntent {
+    private WidgetClickIntent() {}
+
+    public static PendingIntent create(Context context, String provider, int widgetId,
+                                       String action, Bundle data) {
+        Bundle payload = data == null ? new Bundle() : data;
+        Uri identity = new Uri.Builder().scheme("widget-click").authority(context.getPackageName())
+            .appendPath(provider).appendPath(Integer.toString(widgetId)).appendPath(action)
+            .appendQueryParameter("id", payload.getString("id", ""))
+            .appendQueryParameter("uri", payload.getString("uri", "")).build();
+        Intent intent = new Intent(context.getPackageName() + ".WIDGET_CLICK")
+            .setComponent(new ComponentName(context, provider)).setData(identity)
+            .putExtra("widgetId", widgetId).putExtra("clickAction", action)
+            .putExtra("clickActionData", payload);
+        return PendingIntent.getBroadcast(context, 0, intent,
+            PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+    }
+
+    public static PendingIntent createCollectionTemplate(Context context, String provider,
+                                                         int widgetId) {
+        Intent intent = new Intent(context.getPackageName() + ".WIDGET_CLICK")
+            .setComponent(new ComponentName(context, provider)).setData(new Uri.Builder()
+                .scheme("widget-click-template").authority(context.getPackageName())
+                .appendPath(provider).appendPath(Integer.toString(widgetId)).build())
+            .putExtra("widgetId", widgetId);
+        return PendingIntent.getBroadcast(context, 0, intent,
+            PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_MUTABLE);
+    }
+}
