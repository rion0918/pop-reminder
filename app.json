{
  "expo": {
    "name": "ふわっと。",
    "slug": "pop-reminder",
    "scheme": "popreminder",
    "version": "0.1.0",
    "description": "忘れる前に、数秒だけ。ふわっと残せるシンプルなリマインダーアプリです。",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFF8FF"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.rion0918.popreminder"
    },
    "android": {
      "package": "com.rion0918.popreminder",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/app-icon.png",
        "backgroundColor": "#EFF8FF"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#EFF8FF"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#EFF8FF",
      "barStyle": "dark-content"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5F7FE8"
        }
      ],
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "ふわっと。が端末を右へ傾けた動きを検出するために、モーションデータを使用します。"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ふわっと。がリマインダーのタイトルを端末内で文字にするために、マイクを使用します。",
          "speechRecognitionPermission": "ふわっと。が音声を端末内で文字に変換するために、音声認識を使用します。",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.tts",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PopReminderWidget",
              "label": "ふわっと。",
              "description": "リマインダーのシャボン玉を表示＆すばやく追加",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8663b7fe-5742-42cf-9ada-86d70b2c31dd"
      }
    }
  }
}
